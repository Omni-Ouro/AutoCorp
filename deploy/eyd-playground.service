[Unit]
Description=Omni-Ouro EyD playground (business SDK)
After=network.target eyd-clearinghouse.service
Wants=eyd-clearinghouse.service

[Service]
User=eyd
WorkingDirectory=/opt/eyd
EnvironmentFile=/opt/eyd/eyd.env
# Enroll happens at process start; wait for the Clearing House first.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -sf http://127.0.0.1:8787/ >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/eyd/.venv/bin/python playground/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
