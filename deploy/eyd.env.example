# EyD beta droplet environment — copy to /opt/eyd/eyd.env (chmod 600).
# Agents bring their own model credentials. The Clearing House needs a
# gateway token only for the advisory expectation vector (below); the
# playground never calls a model.

# --- Clearing House (v0.1.0) ---
HOST=127.0.0.1
PORT=8787
CLEARINGHOUSE_KEY_FILE=/opt/eyd/state/ch-key.json
CH_STATE_FILE=/opt/eyd/state/clearinghouse.json
# Locks /seed and /boost (trust-minting demo endpoints) on the public
# instance. Generate one: openssl rand -hex 24. Never commit the value.
CH_ADMIN_TOKEN=CHANGE-ME
# Optional: model expectation vector (advisory; sketches generated from
# verb/tool/target only). Leave unset to run vector one only. Shown with
# the Baseten serving of the Meta open-weight model:
# MODEL_GATEWAY_URL=https://inference.baseten.co/v1
# MODEL_GATEWAY_FORMAT=openai
# EXPECTATION_MODEL=meta-models/muse-spark-open-1026
# MODEL_GATEWAY_TOKEN=CHANGE-ME

# --- Playground (business SDK, eyd.omni-ouro.com) ---
CLEARINGHOUSE_URL=http://127.0.0.1:8787
# Advertised to agents in EyD-Clearinghouse challenge headers; the
# localhost URL above stays the server-side path.
CLEARINGHOUSE_PUBLIC_URL=https://clearinghouse.omni-ouro.com
PLAYGROUND_PORT=8002
PLAYGROUND_DOMAIN=eyd.omni-ouro.com
PLAYGROUND_PUBLIC_URL=https://eyd.omni-ouro.com
PLAYGROUND_KEY_FILE=/opt/eyd/state/site-key.json
