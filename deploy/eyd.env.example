# EyD beta droplet environment — copy to /opt/eyd/eyd.env (chmod 600).
# No model credentials live here: agents bring their own; the
# Clearing House and the playground never call a model.

# --- Clearing House (v0.1.0) ---
HOST=127.0.0.1
PORT=8787
CLEARINGHOUSE_KEY_FILE=/opt/eyd/state/ch-key.json
CH_STATE_FILE=/opt/eyd/state/clearinghouse.json
# Locks /seed and /boost (trust-minting demo endpoints) on the public
# instance. Generate one: openssl rand -hex 24. Never commit the value.
CH_ADMIN_TOKEN=CHANGE-ME

# --- Playground (business SDK, eyd.omni-ouro.com) ---
CLEARINGHOUSE_URL=http://127.0.0.1:8787
PLAYGROUND_PORT=8002
PLAYGROUND_DOMAIN=eyd.omni-ouro.com
PLAYGROUND_PUBLIC_URL=https://eyd.omni-ouro.com
PLAYGROUND_KEY_FILE=/opt/eyd/state/site-key.json
